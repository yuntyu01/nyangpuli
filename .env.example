# Server-bound identities; never commit .env or real conversations.
# Generate a random 32-byte token locally; do not use this placeholder as a real key.
NYANG_API_TOKEN=replace-with-a-random-local-token
NYANG_USER_ID=local-demo
NYANG_MEMORY_PATH=data/private/memory.json
# Reading snapshots default to data/private/readings.json.
# Override with: serve --readings /path/to/readings.json (no environment variable).
# Optional JSON object maps user IDs to distinct random tokens:
# NYANG_USERS_JSON={"alice":"random-token-a","bob":"random-token-b"}
# This file is not automatically loaded; export the required values yourself.
# Optional real model calls require explicit opt-in:
#   compare --generate
#   serve --enable-generation
# Both may incur provider charges; no live LLM evaluation has been run yet.
# serve --test-unlocks enables DEV-ONLY simulated detail access, not payment.
# Both server flags default to off. Do not expose test unlocks in production.
NYANG_LLM_API_BASE=https://api.openai.com/v1
NYANG_LLM_API_KEY=
NYANG_LLM_MODEL=
NYANG_LLM_MAX_TOKENS=1024
# Choose the cap for your model and detail length; truncated output is not saved as complete.
# Self-hosted Mem0 integration is optional; no live Mem0 validation yet.
# MEM0_BASE_URL=http://127.0.0.1:8000
# MEM0_API_KEY=
